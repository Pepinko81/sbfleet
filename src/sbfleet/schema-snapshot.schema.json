      },
      "title": "Objects",
      "type": "array"
    },
    "pin": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Pin",
      "type": "object"
    },
    "project": {
      "title": "Project",
      "type": "string"
    },
    "schema_model_version": {
      "const": "sbfleet-schema-v1",
      "default": "sbfleet-schema-v1",

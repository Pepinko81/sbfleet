            "type": "string"
          },
          "title": "Key",
          "type": "array"
        },
        "kind": {
          "enum": [
            "SCHEMA",
            "TABLE",
            "COLUMN",
            "CONSTRAINT",
            "INDEX",
            "FUNCTION",
            "RLS",
            "POLICY",
            "VIEW",
            "MATERIALIZED_VIEW",
            "ENUM",
            "SEQUENCE",
            "TRIGGER",
            "EXTENSION",
            "UNSUPPORTED"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "key",
        "facts"
      ],
      "title": "SchemaObject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
